# Ollama and embedding models
OLLAMA_MODEL=qwen3-vl:4b
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Storage paths and ChromaDB collection
CHROMA_PATH=data/chroma
CHROMA_COLLECTION=pdf_documents
DOCUMENTS_PATH=documents
IMAGE_OUTPUT_DIR=data/images

# Chunking and retrieval
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
RETRIEVAL_COUNT=5

# Optional access control for network-exposed deployments
# APP_PASSWORD=change-this-before-exposing-the-app
# STREAMLIT_SERVER_ADDRESS=127.0.0.1
PUBLIC_DEPLOYMENT=false

# Maximum uploaded PDF size
MAX_UPLOAD_BYTES=209715200

# Database archive safety limits
MAX_DATABASE_ARCHIVE_BYTES=209715200
MAX_DATABASE_ARCHIVE_FILES=10000
MAX_DATABASE_ARCHIVE_UNCOMPRESSED_BYTES=1073741824
